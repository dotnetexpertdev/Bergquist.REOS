# Morning Assistant POC - environment template (contains no secrets)
#
# Copy to the PROJECT ROOT:   copy .env.example .env
# The CLI, migrations, tests and server all read this same file no matter which
# folder you start them from. (An older backend\.env is still used if there is
# no root .env.) Check with:  python backend\cli.py doctor

# --- Application ------------------------------------------------------------
# Origin the browser uses. OAuth redirect URIs are PUBLIC_ORIGIN + the callback paths below.
PUBLIC_ORIGIN=http://localhost:8000
# At least 32 characters. Generate with: python backend\cli.py generate-keys
SESSION_SECRET=
OWNER_USERNAME=owner
# Generate with: python backend\cli.py create-owner
OWNER_PASSWORD_HASH=
# SQLite database and original files. A relative path is relative to the folder
# that contains THIS .env file (./data next to a root .env = C:\...\POC\data).
DATA_PATH=./data
# Fernet key for OAuth tokens at rest. Generate with: python backend\cli.py generate-keys
TOKEN_ENCRYPTION_KEY=
OWNER_TIMEZONE=America/New_York
DEBUG=false
MAX_UPLOAD_SIZE_MB=25

# --- Gmail (read-only) --------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Path only. Register PUBLIC_ORIGIN + this path in Google Cloud (e.g. http://localhost:8000/api/gmail/callback)
GMAIL_OAUTH_CALLBACK=/api/gmail/callback
GMAIL_LABEL_NAME=Property Demo

# --- QuickBooks ---------------------------------------------------------------
# "sandbox" = Intuit developer sandbox company (Development keys)
# "production" = a real QuickBooks Online test subscription (Production keys)
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# Path only. Register PUBLIC_ORIGIN + this path with Intuit (e.g. http://localhost:8000/api/quickbooks/callback)
QUICKBOOKS_OAUTH_CALLBACK=/api/quickbooks/callback
# REQUIRED before any bill is created: the Company ID (realm ID) of your test company.
QUICKBOOKS_EXPECTED_REALM_ID=
# The company's home currency; bills in other currencies stay in review.
QUICKBOOKS_HOME_CURRENCY=USD
QUICKBOOKS_MINOR_VERSION=75

# --- OpenAI (server side only) ----------------------------------------------------
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_SEARCH_MODEL=gpt-4o-mini

# --- Todoist (optional extension) ------------------------------------------------
TODOIST_ENABLED=false
TODOIST_API_TOKEN=
TODOIST_PROJECT_ID=
TODOIST_DEFAULT_REVIEW_DAYS=3
